<Project>
  <PropertyGroup>
    <!--
      Versioning is derived from git tags by MinVer. Pushing a `vX.Y.Z` tag IS the release.
      Untagged builds produce a pre-release version (e.g. 0.5.1-alpha.0.N). No static
      <Version> is set here — see docs/releases.md.
    -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Scratch-tree hygiene (LOCAL-ONLY; revert before commit):
      stale root-owned build-output copies renamed to *.rootbak so the active
      atlas-owned obj/bin can rebuild. These copies are never source.
      Property (not item): evaluated before the SDK's default Compile globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/*.rootbak/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
